# Referência: Spring Boot não carrega este arquivo automaticamente.
# Exporte as variáveis no terminal ou use a configuração de execução da IDE.
JIRA_BASE_URL=https://sua-empresa.atlassian.net
JIRA_EMAIL=seu-email@empresa.com
JIRA_API_TOKEN=
JIRA_API_VERSION=3
JIRA_AUTH_MODE=basic
# Data Center: use versão 2 e bearer com um personal access token, conforme seu servidor.
JIRA_AREA_FIELD=
# A geração fica desativada por padrão. A integração será retomada depois da estrutura do backend.
PLATAFORMA_IA_MODO=desativada
ANTHROPIC_API_KEY=
# Fixe um ID de modelo disponível na sua conta.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=4096
# USD por milhão de tokens da versão escolhida, conforme tabela do provedor.
ANTHROPIC_INPUT_PRICE=
ANTHROPIC_OUTPUT_PRICE=
# Nomes e termos que não podem sair da empresa; separados por ponto e vírgula.
SENSITIVE_TERMS=
PLATAFORMA_DB_PASSWORD=

# Banco consultado pela plataforma. Separado do H2 local; use uma conta com GRANT SELECT.
ERP_POSTGRES_HABILITADO=false
ERP_POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/seu_banco
ERP_POSTGRES_USUARIO=plataforma_leitura
ERP_POSTGRES_SENHA=
ERP_POSTGRES_TIMEOUT_SEGUNDOS=10
ERP_POSTGRES_MAX_LINHAS=1000
ERP_POSTGRES_MAX_CARACTERES=1000000
