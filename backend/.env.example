# Copie para backend/.env (ignorado pelo Git) e inicie a aplicação de backend.
# O .env é importado como properties; variáveis exportadas no terminal têm precedência.
JIRA_BASE_URL=https://sua-empresa.atlassian.net
JIRA_EMAIL=seu-email@empresa.com
JIRA_API_TOKEN=
JIRA_API_VERSION=3
JIRA_AUTH_MODE=basic
# Data Center: use versão 2 e bearer com um personal access token, conforme seu servidor.
JIRA_AREA_FIELD=
# Opcional: IDs das situações do seu workflow, separados por vírgula. Ex.: 10001:EM_TESTE
JIRA_STATUS_MAPA=
# Escrita só ocorre por ação explícita na tela/API, quando habilitada.
JIRA_ESCRITA_HABILITADA=false
# IDs das transições disponíveis no seu workflow. Ex.: EM_TESTE:31,FINALIZADA:41
JIRA_TRANSICOES=

CONFLUENCE_BASE_URL=https://sua-empresa.atlassian.net/wiki
CONFLUENCE_EMAIL=seu-email@empresa.com
CONFLUENCE_API_TOKEN=
# Cloud: versão 2; Data Center/REST antigo: versão 1, ajustando base URL e auth.
CONFLUENCE_API_VERSION=2
CONFLUENCE_AUTH_MODE=basic
# Mapeie tarefas ou áreas para IDs numéricos de páginas. Ex.: ESTOQUE:12345,PROJ-123:67890
CONFLUENCE_PAGINAS=

# desativada: entrada manual; externa: Gemini/Llama. Claude continua pendente.
PLATAFORMA_IA_MODO=desativada
PLATAFORMA_IA_PROVEDOR=GEMINI
MODELOS_MAX_TOKENS=4096
GEMINI_HABILITADO=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INPUT_PRICE=
GEMINI_OUTPUT_PRICE=
GROQ_HABILITADO=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_INPUT_PRICE=
GROQ_OUTPUT_PRICE=
# Regras reais de empresa, filial, cancelamento e exclusão lógica. Obrigatórias para gerar SQL.
DOMINIO_REGRAS=

# Adaptador legado da API preservado; não é necessário configurar Claude nesta entrega.
ANTHROPIC_API_KEY=
# Fixe um ID de modelo disponível na sua conta.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=4096
# USD por milhão de tokens da versão escolhida, conforme tabela do provedor.
ANTHROPIC_INPUT_PRICE=
ANTHROPIC_OUTPUT_PRICE=
# Nomes e termos que não podem sair da empresa; separados por ponto e vírgula.
SENSITIVE_TERMS=
PLATAFORMA_DB_PASSWORD=

# Banco consultado pela plataforma. Separado do H2 local; use uma conta com GRANT SELECT.
ERP_POSTGRES_HABILITADO=false
ERP_POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/seu_banco
ERP_POSTGRES_USUARIO=plataforma_leitura
ERP_POSTGRES_SENHA=
ERP_POSTGRES_TIMEOUT_SEGUNDOS=10
ERP_POSTGRES_MAX_LINHAS=1000
ERP_POSTGRES_MAX_CARACTERES=1000000

# Schemas autorizados no catálogo e colunas autorizadas para amostragem, separados por vírgula.
ERP_CATALOGO_SCHEMAS=public
# Vazio por padrão; exemplo: public.produto.status,public.movimento.tipo
ERP_AMOSTRA_COLUNAS=
ERP_AMOSTRA_MAX_VALORES=5
ERP_CATALOGO_MAX_TABELAS=12
ERP_CATALOGO_PROFUNDIDADE=1
ERP_CATALOGO_CACHE_SEGUNDOS=60
# Só envie amostras aos modelos se a lista de colunas tiver sido revisada para essa finalidade.
ERP_AMOSTRA_ENVIAR_MODELOS=false
