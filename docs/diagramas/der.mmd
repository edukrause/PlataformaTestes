%%{init: {"theme":"neutral","themeVariables":{"fontFamily":"Arial","fontSize":"18px"}}}%%
erDiagram
    TAREFA ||--o{ EXECUCAO : "origina"
    EXECUCAO ||--|{ CENARIO : "produz"
    EXECUCAO ||--o{ CHAMADA_MODELO : "audita"
    EXECUCAO ||--o{ APURACAO : "contém"
    CENARIO |o--o{ APURACAO : "recebe valor de"
    APURACAO ||--|{ CANDIDATO_SQL : "reúne"
    EXECUCAO ||--o| REVISAO : "decisão vigente"
    EXECUCAO ||--o{ HISTORICO_REVISAO : "decisões anteriores"
    EXECUCAO ||--o{ PUBLICACAO_JIRA : "publica"

    TAREFA {
        bigint id PK
        varchar chave_jira
        varchar origem "JIRA | MANUAL"
        clob requisito
        varchar documentacao_ref
        varchar hash_documentacao
    }
    EXECUCAO {
        bigint id PK
        bigint tarefa_id FK
        varchar versao_prompt
        varchar status
        bigint tempo_total_ms
        decimal custo_total_usd
    }
    CENARIO {
        bigint id PK
        bigint execucao_id FK
        varchar tipo "ALTERACAO | REGRESSAO"
        clob gherkin
        boolean sintaxe_valida
    }
    CHAMADA_MODELO {
        bigint id PK
        bigint execucao_id FK
        varchar provedor
        varchar modelo
        varchar finalidade "CENARIOS | SQL"
        decimal temperatura
        clob prompt_enviado
        decimal custo_usd
    }
    APURACAO {
        bigint id PK
        bigint execucao_id FK
        bigint cenario_id FK
        varchar origem "MANUAL | MODELOS"
        varchar desfecho "UNANIME | MAIORIA | DIVERGENTE | FALHA"
        clob resultado_referencia
    }
    CANDIDATO_SQL {
        bigint id PK
        bigint apuracao_id FK
        varchar provedor "CLAUDE | GEMINI | LLAMA"
        int tentativa
        clob consulta
        varchar verificacao
        varchar hash_resultado
    }
    REVISAO {
        bigint id PK
        bigint execucao_id FK
        varchar decisao "ACEITO | ACEITO_ALTERACAO | REJEITADO"
        int valores_alterados
        bigint tempo_revisao_s
    }
    HISTORICO_REVISAO {
        bigint id PK
        bigint execucao_id FK
        varchar decisao
    }
    PUBLICACAO_JIRA {
        bigint id PK
        bigint execucao_id FK
        bigint revisao_id
        varchar status
    }
